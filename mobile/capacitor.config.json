{
  "appId": "com.jollofliving.app",
  "appName": "Jollof Living",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0B0F0C"
  },
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#0B0F0C",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B0F0C"
    }
  }
}
