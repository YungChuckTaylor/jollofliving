{
  "name": "jollof-living-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Jollof Living — Android app. Bundled UI, synced with the same MySQL database as the website.",
  "scripts": {
    "sprites": "node tools/make-sprites.mjs",
    "build": "node tools/build.mjs",
    "sync": "npm run build && npx cap sync android",
    "open": "npx cap open android",
    "apk": "cd android && ./gradlew assembleDebug",
    "release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/network": "^6.0.3",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0"
  }
}
